{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zap-dispatch-marketing",
  "compatibility_date": "2026-07-18",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "zapdispatch.com/*",
      "zone_name": "zapdispatch.com"
    },
    {
      "pattern": "www.zapdispatch.com/*",
      "zone_name": "zapdispatch.com"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
